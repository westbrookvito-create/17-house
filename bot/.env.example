# Токен бота от @BotFather
BOT_TOKEN=123456:AAExampleTokenReplaceMe

# Telegram ID администраторов через запятую (узнать свой id можно у @userinfobot)
ADMIN_IDS=111111111,222222222

# URL мини-приложения на Netlify (после деплоя webapp), например https://17house.netlify.app
WEBAPP_URL=https://your-app.netlify.app

# Порт, на котором поднимается REST API для мини-аппа (Railway подставит свой автоматически)
PORT=3000

# Название клуба/бренда, используется в текстах бота
CLUB_NAME=17 House

# Сколько купленных футболок нужно для разблокировки бонуса 10%
BONUS_THRESHOLD=3
BONUS_PERCENT=10

# Список источников (через запятую), которым разрешено обращаться к REST API (CORS).
# Укажите домен вашего Netlify-приложения.
CORS_ORIGIN=https://your-app.netlify.app

# Только для локальной разработки: разрешает открывать мини-апп в обычном браузере
# (не внутри Telegram) через заголовок X-Debug-User-Id. НЕ включайте в проде.
# DEV_ALLOW_INSECURE=1

# Персональные статусы в профиле для конкретных Telegram ID вместо обычного
# "Member" — например "Разработчик" красным. Формат: JSON-объект telegram_id -> {label, color}.
# По умолчанию (без этой переменной) первый ID из ADMIN_IDS получает "Разработчик",
# а id 5660002280 — "Администратор", оба красным (#d96c6c). Задав SPECIAL_STATUSES
# явно, можно добавить ещё админов или переопределить эти два.
# SPECIAL_STATUSES={"111111111":{"label":"Разработчик","color":"#d96c6c"},"5660002280":{"label":"Администратор","color":"#d96c6c"}}
